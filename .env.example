# 이 파일을 .env 로 복사해서 값을 채웁니다. (.env 는 저장소에 올라가지 않습니다)
# application.properties 가 실행 시 .env 를 자동으로 읽습니다.

# 실행 프로필 (local: 템플릿·CSS 수정이 재시작 없이 반영)
SPRING_PROFILES_ACTIVE=local

# --- DB: Supabase Postgres (2단계) ---
# Supabase 대시보드 > 상단 Connect > "Session pooler" 의 값을 JDBC 형식으로 옮긴다.
#   DB_URL      jdbc:postgresql://aws-0-<지역>.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME postgres.<프로젝트 ref>
#   DB_PASSWORD 프로젝트를 만들 때 정한 DB 비밀번호
# 값을 채울 때 앞의 # 을 지운다. 빈 값(DB_URL=)으로 두면 기본값 대신 빈 문자열이 쓰여 오류가 난다.
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=

# --- 레시피 사진 저장소: Supabase Storage (6단계) ---
# SUPABASE_URL          Project Settings > API 의 Project URL (예: https://<프로젝트 ref>.supabase.co)
# SUPABASE_SERVICE_KEY  Project Settings > API Keys 의 서버용 키 (service_role 또는 secret key)
#                       서버 전용 비밀 값이다. 브라우저·템플릿에 노출하지 않는다.
# SUPABASE_BUCKET=recipe-images
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# --- 5단계에서 사용: 소셜 로그인 ---
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# īī�� ���� JavaScript Ű (īī�� ������ > �� > �÷��� Ű > JavaScript Ű, �� �����ο� http://localhost:8080 ���)
KAKAO_MAP_KEY=
